<% if (typeof errors !== 'undefined' && errors.length) { %>
  <div class="alert alert-error" role="alert">
    <h2 class="alert-title">There is a problem with your answers</h2>
    <ul>
      <% errors.forEach(function (message) { %>
        <li><%= message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
