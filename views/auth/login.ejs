<%- include('../partials/head') %>

<h1>Log in</h1>
<p>Use the email address and password you registered with.</p>

<%- include('../partials/errors', { errors: errors }) %>

<form method="post" action="/login" class="form">
  <input type="hidden" name="next" value="<%= next %>">

  <div class="field">
    <label for="email">Email address</label>
    <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="username"
           required aria-describedby="email-hint" <%= errors.length ? 'aria-invalid="true"' : '' %>>
    <p class="hint" id="email-hint">For example student@campus.edu.</p>
  </div>

  <div class="field">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>
  </div>

  <button type="submit" class="btn">Log in</button>
</form>

<p>No account yet? <a href="/register">Create one now</a>.</p>
<p class="hint">Demo accounts: student@campus.edu / Student@123, organizer@campus.edu / Organizer@123, admin@campus.edu / Admin@123.</p>

<%- include('../partials/foot') %>
